# =============================================================================
# 사내 LLM Wiki - 환경변수 예시 (config/env.example)
# (저장소 루트의 ".env.example" 이름은 이 환경의 권한 규칙으로 쓸 수 없어 config/ 아래에 둔다.
#  필요하면 사람이 `copy config\env.example .env.example` 로 복사해도 된다.)
#
# 사용법:  이 파일을 저장소 루트의 ".env" 로 복사해서 값을 채운다.  .env 는 .gitignore 대상이며 절대 커밋하지 않는다.
#          scripts\run-*.ps1 이 .env 를 읽어 환경변수로 넣는다 (KEY=VALUE 한 줄씩, 값 확장/코드 실행 없음).
#          줄 앞의 '#' 은 주석. 따옴표는 쓰지 않아도 된다(쓰면 바깥 따옴표 한 쌍만 벗김). 줄 끝 주석은 지원하지 않는다.
# 비밀값: API 키/세션 비밀키를 이 파일에 직접 적지 말고, 가능하면 파일로 두고 *_FILE 로 경로를 가리킨다.
#         (예: 키를 한 줄만 담은 C:\wiki-secrets\gauss.key, 폴더는 서비스 계정만 읽도록 ACL 설정)
# 이 파일은 src/ 에서 쓰는 WIKI_* 변수 전부를 담는다 (docs/DEV-GUIDE.md 의 "환경변수 점검" 참고).
# =============================================================================

# -----------------------------------------------------------------------------
# [1] 공통 / 환경
# -----------------------------------------------------------------------------
# development | test | production.  비어 있으면 production(엄격, fail-closed).
# dev 로그인(WIKI_AUTH_PROVIDER=dev)은 development/test 에서만 허용된다. 사내 운영은 반드시 production.
WIKI_ENV=development
# 데이터 루트 (inbox/ raw/ wiki/ wiki.db sessions.db 가 여기에 생김). 로컬 디스크 권장
# (네트워크 드라이브/OneDrive 는 SQLite WAL 이 안 될 수 있음 - doctor 가 경고).
WIKI_DATA_DIR=./data
# 인증 방식: dev(개발용 가짜 로그인) | saml(사내에서 구현 필요 - 현재 NotImplementedError)
WIKI_AUTH_PROVIDER=dev
# 개발용 사용자 목록 JSON 경로 (dev 인증 전용). 형식은 src/llmwiki/web/__main__.py 상단 주석 참고.
# WIKI_DEV_USERS_FILE=./config/dev-users.json
# 인제스트 시 개인정보(PII) 마스킹 기본값. 1|true|yes|on 이면 켬. space별 정책은 [7] WIKI_PII_POLICY_FILE.
WIKI_MASK_PII=0

# -----------------------------------------------------------------------------
# [2] 웹 서버
# -----------------------------------------------------------------------------
# 서버 종류: waitress(운영, pip install -e .[prod]) | wsgiref(개발). 비우면 waitress 설치 시 waitress, 아니면 wsgiref.
# WIKI_SERVER=waitress
# 바인딩 주소/포트. 기본은 로컬 전용. 리버스 프록시가 같은 PC 에서 접속하면 127.0.0.1 그대로 둔다.
WIKI_HOST=127.0.0.1
WIKI_PORT=8080
# [운영 필수] 세션 서명 비밀키, 32자 이상 무작위 문자열. 개발에서는 비워 두면 프로세스마다 임의 생성(재시작 시 로그아웃).
# 값을 이 파일에 적는 것이 불가피하면 .env 파일 권한을 서비스 계정으로 제한한다.
WIKI_SESSION_SECRET=
# [운영 필수] 브라우저가 접속하는 정확한 Origin(scheme://host[:port], 경로 없음), 쉼표로 여러 개.
# 예: https://wiki.corp.example  - 프록시가 Host 헤더를 바꿔도 이 값만 신뢰한다. 개발에서는 불필요.
WIKI_ALLOWED_ORIGINS=
# Secure 쿠키. 비우면 운영=1, 개발=0. HTTPS(리버스 프록시) 뒤에서는 반드시 1.
# WIKI_COOKIE_SECURE=1
# 세션 유휴 만료(초, 기본 1800) / 절대 만료(초, 기본 28800 = 8시간; AD 그룹 변경은 재로그인으로 반영)
# WIKI_SESSION_IDLE_SECONDS=1800
# WIKI_SESSION_ABSOLUTE_SECONDS=28800
# 업로드 본문 최대 바이트(기본 50 MiB) / JSON 요청 최대 바이트(기본 64 KiB)
# WIKI_MAX_UPLOAD_BYTES=52428800
# WIKI_MAX_JSON_BYTES=65536
# 소켓 타임아웃(초, 기본 30; waitress channel_timeout 으로도 쓰임) / 동시 스레드(기본 64)
# WIKI_SOCKET_TIMEOUT=30
# WIKI_MAX_THREADS=64
# 속도 제한: 사용자별 분당 요청(기본 120), 로그인 계열 주소별 분당(기본 20)
# WIKI_RATE_USER_PER_MIN=120
# WIKI_RATE_LOGIN_PER_MIN=20

# -----------------------------------------------------------------------------
# [3] 채팅 LLM  (OpenAI 호환 /chat/completions)
# -----------------------------------------------------------------------------
# WIKI_LLM_PROVIDER: openai(기본) | custom(JSON 설정 기반, config/llm-custom.example.json 참고)
# WIKI_LLM_PROVIDER=openai
# WIKI_LLM_CUSTOM_CONFIG=./config/llm-custom.json
# 엔드포인트(.../v1 까지)와 모델 id. 기본값은 LM Studio 로컬.
WIKI_LLM_BASE_URL=http://127.0.0.1:1234/v1
WIKI_LLM_MODEL=local-model
# Bearer 키: 파일(권장) 또는 직접 값. 둘 다 없으면 Authorization 헤더를 보내지 않는다. 로그/오류에 값이 나오지 않음.
# WIKI_LLM_API_KEY_FILE=C:\wiki-secrets\gauss.key
# WIKI_LLM_API_KEY=
# 구조화 출력: auto(시도 후 400 이면 포기) | off(response_format 을 아예 보내지 않음). Gauss 는 JSON schema 미지원 -> off.
# WIKI_LLM_STRUCTURED=auto
# SSE 스트리밍(1|0). think(추론) 모델은 1 권장.
# WIKI_LLM_STREAM=0
# 요청 타임아웃(초, 기본 120; 스트리밍이면 소켓 읽기당). think 모델은 300 이상.
# WIKI_LLM_TIMEOUT=120
# 응답 최대 토큰(기본: 보내지 않음). think 모델은 추론에 토큰을 쓰므로 4096 이상.
# WIKI_LLM_MAX_TOKENS=4096
# 모델 컨텍스트 창(토큰). 검색 컨텍스트 예산 계산에 쓰임. 기본 8192(작게 가정). 실제 값으로 올려야 함.
# WIKI_LLM_CONTEXT_TOKENS=8192
# 네트워크 정책(기본: 사설/루프백 주소만 허용, 프록시 환경변수 무시, 리다이렉트 불가).
# 사내 DNS 이름이 사설 IP 가 아니거나 확인 불가할 때만 호스트 이름(포트 없음)을 쉼표로 명시 허용.
# WIKI_LLM_ALLOWED_HOSTS=gauss.corp.example
# 명시적 프록시(http://host:port) / 사내 CA PEM 번들 경로
# WIKI_LLM_PROXY=
# WIKI_LLM_CA_BUNDLE=C:\wiki-secrets\corp-ca.pem

# -----------------------------------------------------------------------------
# [4] 임베딩  (OpenAI 호환 /embeddings; 사내: 같은 PC 의 LM Studio bge-m3)
# -----------------------------------------------------------------------------
# 모델 id. 비우거나 off/none/false/0/disabled 이면 임베딩 끄고 BM25 만 사용.
# 미설정 시 기본값 text-embedding-bge-m3.
WIKI_EMBED_MODEL=text-embedding-bge-m3
# 비우면 WIKI_LLM_BASE_URL 을 쓴다 -> 채팅이 Gauss 인 현장에서는 반드시 별도로 지정.
# WIKI_EMBED_BASE_URL=http://127.0.0.1:1234/v1
# WIKI_EMBED_PROVIDER=openai
# WIKI_EMBED_CUSTOM_CONFIG=./config/embed-custom.json
# 임베딩 전용 키/정책. 채팅 쪽 값은 호스트:포트가 같을 때만 상속된다(채팅 키가 다른 서버로 가지 않게).
# WIKI_EMBED_API_KEY_FILE=
# WIKI_EMBED_API_KEY=
# WIKI_EMBED_ALLOWED_HOSTS=
# WIKI_EMBED_PROXY=
# WIKI_EMBED_CA_BUNDLE=
# 질의 시점 임베딩 호출 타임아웃(초, 기본 5; 정체돼도 모든 웹 질의가 오래 묶이지 않게)
# WIKI_EMBED_QUERY_TIMEOUT=5

# -----------------------------------------------------------------------------
# [5] 인제스트 / 컴파일 한도
# -----------------------------------------------------------------------------
# 파서 입력 파일 최대 바이트(기본 50 MiB)
# WIKI_MAX_INPUT_BYTES=52428800
# 컴파일 시 LLM 에 보내는 원문 최대 글자(기본 12000, 최소 1000). 컨텍스트가 큰 모델이면 올릴 수 있음.
# WIKI_COMPILE_MAX_CHARS=12000

# -----------------------------------------------------------------------------
# [6] OCR  (슬롯만 있음 - 현장에서 엔진 연결 시 WIKI_OCR_* 이름으로 정의)
# -----------------------------------------------------------------------------
# doctor 는 WIKI_OCR 로 시작하는 변수가 하나라도 있으면 "OCR 설정 감지"로만 표시한다(값 미검증).
# 실제 연결은 [7] 의 WIKI_OCR_COMMAND (docs/ONSITE-HANDOFF.md b-5). WIKI_OCR_ENGINE/WIKI_OCR_PYTHON 은 코드가 읽지 않는 메모용 이름이다.
# WIKI_OCR_ENGINE=paddleocr
# WIKI_OCR_PYTHON=C:\ocr-venv\Scripts\python.exe

# =============================================================================
# 프로필 A: 사내 (Gauss Chat API + 같은 PC 의 LM Studio 임베딩)  -- 위 값 대신 아래로 바꿔 사용
# 주의: URL/모델 id/호스트 이름은 예시이다. 실제 Gauss 주소와 모델 id 는 현장에서 확인한다 (미검증).
# =============================================================================
# WIKI_ENV=production
# WIKI_DATA_DIR=D:\wiki-data
# WIKI_AUTH_PROVIDER=saml
# WIKI_HOST=127.0.0.1
# WIKI_PORT=8080
# WIKI_SERVER=waitress
# WIKI_SESSION_SECRET=<32자 이상 무작위 - 가능하면 환경/비밀 저장소에서 주입>
# WIKI_ALLOWED_ORIGINS=https://wiki.corp.example
# WIKI_COOKIE_SECURE=1
# WIKI_LLM_BASE_URL=https://gauss.corp.example/v1
# WIKI_LLM_MODEL=<Gauss 모델 id>
# WIKI_LLM_API_KEY_FILE=C:\wiki-secrets\gauss.key
# WIKI_LLM_STRUCTURED=off
# WIKI_LLM_STREAM=1
# WIKI_LLM_TIMEOUT=300
# WIKI_LLM_MAX_TOKENS=4096
# WIKI_LLM_CONTEXT_TOKENS=65536
# WIKI_LLM_ALLOWED_HOSTS=gauss.corp.example
# WIKI_LLM_CA_BUNDLE=C:\wiki-secrets\corp-ca.pem
# WIKI_EMBED_BASE_URL=http://127.0.0.1:1234/v1
# WIKI_EMBED_MODEL=text-embedding-bge-m3
# WIKI_MAX_THREADS=64

# =============================================================================
# 프로필 B: 집 개발 (LM Studio 하나로 채팅+임베딩, dev 로그인)
# =============================================================================
# WIKI_ENV=development
# WIKI_AUTH_PROVIDER=dev
# WIKI_DEV_USERS_FILE=./config/dev-users.json
# WIKI_LLM_BASE_URL=http://127.0.0.1:1234/v1
# WIKI_LLM_MODEL=<LM Studio 에 로드한 채팅 모델 id, 예: gemma 계열>
# WIKI_LLM_CONTEXT_TOKENS=8192
# WIKI_EMBED_MODEL=text-embedding-bge-m3
# (LM Studio 에서 로드된 컨텍스트 길이가 2048/8192 등으로 작으면 긴 입력이 조용히 잘리거나 오류가 난다. 올릴 것.)

# =============================================================================
# [7] 갭 수정으로 추가된 변수 (OCR 명령 / 프록시 / PII 정책 / 감사 보존)
# =============================================================================
# 외부 OCR 실행 파일(셸 없이 실행). 기본 입력 모드 pdf: PDF 전체를 stdin 으로 받고 페이지별 텍스트를  로 구분해 stdout 출력.
# WIKI_OCR_COMMAND=C:\ocr-venv\Scripts\python.exe
# 실행 파일에 붙일 인자: JSON 문자열 배열
# WIKI_OCR_ARGS=["C:\ocr\run_ocr.py"]
# pdf(기본) | image(stdin 이 PNG/JPEG 한 장일 때만; PDF 는 거부됨)
# WIKI_OCR_INPUT=pdf
# 실행 제한 시간(초, 기본 120) / 출력 상한(바이트, 기본 8388608)
# WIKI_OCR_TIMEOUT=120
# WIKI_OCR_MAX_OUTPUT=8388608
# 리버스 프록시의 정확한 IP(쉼표 목록, CIDR 불가). 이 주소에서 온 요청만 X-Forwarded-For 를 신뢰. 비우면 REMOTE_ADDR 기준(기본).
# WIKI_TRUSTED_PROXIES=10.0.0.5
# space별 PII 마스킹 정책 JSON: {"dept-a": true, "dept-b/part-1": false} (가장 가까운 상위 space 우선, 없으면 WIKI_MASK_PII).
# 파일이 읽히지 않거나 잘못되면 파이프라인이 시작을 거부한다.
# WIKI_PII_POLICY_FILE=./config/pii-policy.json
# (감사 로그: 기본 무기한 보존. 정리는 관리자 CLI 만: python -m llmwiki.audit_admin prune --days N --yes  (N>=30))
