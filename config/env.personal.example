# 개인 PC 모드(python -m llmwiki.personal) 환경 파일 예시.
# 사용: 이 파일을 repo 루트에 ".env.personal" 로 복사해서 값을 고친다. scripts\run-personal.ps1 이 WIKI_* 줄만 읽는다
# (따옴표/변수 치환/코드 실행 없음, 값은 화면에 출력하지 않음). 비밀키 값을 이 파일에 직접 쓰지 말고 *_FILE 로 지정한다.
# 사내 중앙 위키 설정은 config\env.example 이며, 이 파일과 별개다. 중앙 서버(python -m llmwiki.web)는 개인 모드를 거부한다.
#
# 개인 모드에서 고정되는 것 (설정 불가): 사용자 1명(me), 공간 'personal', 바인드 주소 127.0.0.1(또는 ::1),
# 접속 토큰(실행마다 새로 생성), 세션 비밀키(실행마다 새로 생성). WIKI_HOST/WIKI_PORT/WIKI_ENV/WIKI_AUTH_PROVIDER/WIKI_DATA_DIR 는
# 개인 모드에서 무시된다 (WIKI_HOST=0.0.0.0 을 써도 열리지 않는다). 포트는 --port N 옵션 (기본: 빈 포트 자동 선택).

# ---- 데이터 위치 -------------------------------------------------------------------------------------
# 기본: %LOCALAPPDATA%\LLMWiki  (inbox\ raw\ wiki\ wiki.db sessions.db watch_index.db settings.json 이 여기에 생김)
# WIKI_PERSONAL_HOME=D:\MyWiki

# ---- 감시 폴더 (선택): 이미 PC에 있는 문서 폴더. 하위 폴더까지 주기적으로 훑는다 -----------------------------
# 새 파일/바뀐 파일만 "복사"해서 처리한다. 원본은 읽기만 하고 이동/이름변경/수정/삭제하지 않는다.
# 지원: .md .txt .docx .xlsx .eml .pdf. 형식: 절대 경로를 ; 로 구분, 또는 JSON 배열. 비우면 <home>\settings.json 의 {"watch": [...]} 를 본다.
# WIKI_PERSONAL_WATCH=C:\Users\me\Documents\회의록;D:\프로젝트\문서
# WIKI_PERSONAL_WATCH=["C:\\Users\\me\\Documents\\회의록"]

# ======================================================================================================
# 프로필 A: 이 PC의 GPU에서 LM Studio 로컬 모델 (기본). 사내 API 없이 완전히 이 PC 안에서만 동작.
#   - LM Studio 에서 채팅 모델 1개 + 임베딩 모델 bge-m3 를 로드하고 Local Server 를 켠다 (포트 1234).
#   - 작은 모델(예: 4B)은 문서 1건 처리에 수십 초가 걸린다. 컨텍스트 길이(Context Length)를 8192 이상으로 올려 로드한다.
# ======================================================================================================
WIKI_LLM_BASE_URL=http://127.0.0.1:1234/v1
WIKI_LLM_MODEL=local-model
# LM Studio 에서 실제로 로드한 컨텍스트 길이(토큰)와 같게. 크게 쓰면 프롬프트 초과 오류가 난다.
WIKI_LLM_CONTEXT_TOKENS=8192
# 생각(think) 모델이면 출력이 길어진다: 타임아웃과 최대 토큰을 늘린다.
# WIKI_LLM_TIMEOUT=300
# WIKI_LLM_MAX_TOKENS=4096
WIKI_EMBED_MODEL=text-embedding-bge-m3
# 비워 두면: 채팅이 이 PC(127.0.0.1)면 같은 서버, 채팅이 다른 서버면 http://127.0.0.1:1234/v1 (LM Studio) 를 자동 사용.
# WIKI_EMBED_BASE_URL=http://127.0.0.1:1234/v1

# ======================================================================================================
# 프로필 B: 사내 Gauss Chat API (OpenAI 호환, Bearer 키). 임베딩은 계속 이 PC의 LM Studio(bge-m3)를 쓴다.
#   위 프로필 A 의 WIKI_LLM_* 4줄을 주석 처리하고 아래 주석을 푼다. 사내망에서만 접속된다.
#   키는 사용자 프로필 아래 파일에 한 줄로 저장하고, 그 파일 권한을 본인만 읽게 한다 (파일 속성 > 보안, 상속 제거).
#   예) icacls "%USERPROFILE%\.wiki-secrets\gauss.key" /inheritance:r /grant:r "%USERNAME%:R"
# ======================================================================================================
# WIKI_LLM_BASE_URL=https://gauss.corp.example/v1
# WIKI_LLM_MODEL=gauss-chat
# WIKI_LLM_API_KEY_FILE=C:\Users\me\.wiki-secrets\gauss.key
# 사내 도메인 이름 호스트를 쓰려면 정확한 호스트 이름을 허용 목록에 넣는다 (그 외 외부 주소는 거부됨).
# WIKI_LLM_ALLOWED_HOSTS=gauss.corp.example
# WIKI_LLM_STRUCTURED=off
# WIKI_LLM_STREAM=1
# WIKI_LLM_TIMEOUT=300
# WIKI_LLM_CONTEXT_TOKENS=65536
# WIKI_EMBED_BASE_URL=http://127.0.0.1:1234/v1

# ---- 두뇌 선택/자동 전환 (선택) -------------------------------------------------------------------------
# 위의 프로필 A/B 대신 config\brains.json 의 프로필(local/gemini/gauss/claude)로 고르고 싶을 때. config\brains.example.json 참고.
# 개인 모드의 데이터는 보통 personal 등급이다(일기 등 private 노트는 로컬 두뇌만). Gemini/Claude 같은 외부 서비스로는 글이 전송된다.
# WIKI_BRAIN=auto
# WIKI_BRAIN_DATA=personal
# WIKI_BRAINS_FILE=config\brains.json

# ---- 처리 옵션 ------------------------------------------------------------------------------------------
# 저장되는 raw/wiki 사본의 개인정보(전화/주민번호 등) 마스킹. 원본 파일은 마스킹되지 않은 채 디스크에 그대로 남는다.
WIKI_MASK_PII=0
# 파일 하나의 최대 크기(바이트). 이보다 크면 건너뜀(감시 폴더) 또는 거부(inbox).
# WIKI_MAX_INPUT_BYTES=52428800
# 문서 하나당 LLM 에 보내는 최대 글자 수.
# WIKI_COMPILE_MAX_CHARS=12000
# 스캔 PDF 용 외부 OCR 명령(선택): 설정 방법은 docs\ONSITE-HANDOFF.md
# WIKI_OCR_COMMAND=

# 질문이 문서 처리(같은 모델) 뒤에서 기다리는 최대 시간(초). 넘으면 "잠시 후 다시 시도" 안내를 보여 준다. 기본 300.
# WIKI_PERSONAL_QUESTION_WAIT=300

# 이 PC 밖으로 나가는 요청은 위에서 지정한 채팅/임베딩 주소뿐이다. 텔레메트리 없음, 프록시/리다이렉트 기본 금지.
